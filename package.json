{
  "name": "nodeviewjs",
  "version": "0.1.0",
  "description": "A lightweight Node.js desktop runtime using the system WebView.",
  "keywords": [
    "desktop",
    "webview",
    "webview2",
    "nodejs",
    "native"
  ],
  "homepage": "https://github.com/0trebor0/NodeViewJS#readme",
  "bugs": {
    "url": "https://github.com/0trebor0/NodeViewJS/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0trebor0/NodeViewJS.git"
  },
  "author": "0trebor0",
  "main": "runtime/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "default": "./runtime/index.js"
    },
    "./ipc": {
      "types": "./types/ipc.d.ts",
      "default": "./runtime/ipc.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "nodeviewjs": "bin/nodeviewjs.js"
  },
  "files": [
    "bin",
    "examples",
    "runtime",
    "scripts",
    "src-nodeview",
    "types",
    "native-checksums.json"
  ],
  "scripts": {
    "install": "node scripts/install-native.js",
    "setup": "node scripts/setup.js",
    "build": "node scripts/build.js",
    "build:security-analysis": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1 -SecurityAnalysis",
    "clean": "node scripts/clean.js",
    "doctor": "node scripts/doctor.js",
    "start": "node examples/basic/app.js",
    "dev": "node bin/nodeviewjs.js dev",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable.ps1",
    "package": "node bin/nodeviewjs.js package",
    "package:installer": "powershell -ExecutionPolicy Bypass -File scripts/package-installer.ps1",
    "package:macos": "node scripts/package-macos.js",
    "package:linux": "node scripts/package-linux.js",
    "update:manifest": "node scripts/generate-update-manifest.js",
    "test:runtime": "node test/runtime-api.js",
    "test:window-lifecycle": "node test/window-lifecycle.js",
    "test:exports": "node test/package-exports.js",
    "test:doctor": "node test/doctor.js",
    "test:types": "tsc --noEmit -p types/tsconfig.json",
    "test:tarball": "node test/package-tarball.js",
    "test:native-lifecycle": "node test/native-lifecycle.js",
    "test:window-retention": "node test/native-window-retention.js",
    "test:bridge": "npm run test:native-lifecycle && node test/bridge-integration.js && node test/bridge-matrix-integration.js",
    "test:bridge-matrix": "node test/bridge-matrix-integration.js",
    "test:raw-webmessage": "node test/raw-webmessage-diagnostic.js",
    "test:ipc-security": "node test/ipc-security.js",
    "test:net": "node test/net.js",
    "test:error-logging": "node test/error-logging.js",
    "test:ipc-security-integration": "node test/ipc-security-integration.js",
    "test:trusted-document": "node test/trusted-document-integration.js",
    "test:webview-capabilities": "node test/webview-capabilities-integration.js",
    "test:package-inputs": "node test/package-input-security.js",
    "test:integrity": "node test/package-integrity.js",
    "test:pe-hardening": "powershell -NoProfile -ExecutionPolicy Bypass -File test/pe-hardening.ps1",
    "test:security-corpus": "node test/security-corpus.js",
    "test:fuzz": "node test/fuzz-boundaries.js",
    "test:limits": "node --expose-gc test/resource-limits.js",
    "test:updater-failures": "node test/updater-failures.js",
    "test:install": "node test/install-native.js",
    "test:rc": "node test/release-candidate.js",
    "test:multi-window": "node test/multi-window-integration.js",
    "test:cli": "node test/cli.js",
    "test:installer": "powershell -ExecutionPolicy Bypass -File test/installer-smoke.ps1",
    "test:updater": "node test/updater.js",
    "test:plugins": "node test/plugins.js",
    "test:platform": "node test/platform.js",
    "test:single-instance": "node test/app-single-instance.js && node test/single-instance.js",
    "test:associations": "node test/windows-associations.js",
    "test:bundle": "node test/runtime-bundle.js",
    "test:menu": "node test/menu.js",
    "test:menu-native": "powershell -NoProfile -ExecutionPolicy Bypass -File test/menu-native.ps1",
    "test:tray-menu-native": "powershell -NoProfile -ExecutionPolicy Bypass -File test/tray-menu-native.ps1",
    "test:taskbar": "node test/taskbar.js",
    "test:window-colors": "node test/window-colors.js",
    "test:taskbar-native": "powershell -NoProfile -ExecutionPolicy Bypass -File test/taskbar-native.ps1",
    "test:notification": "node test/notification.js",
    "test:notification-native": "powershell -NoProfile -ExecutionPolicy Bypass -File test/notification-native.ps1",
    "test:bridge-embed": "node test/embed-bridge.js",
    "test:native": "npm run test:bridge && npm run test:window-retention && npm run test:raw-webmessage && npm run test:ipc-security-integration && npm run test:trusted-document && npm run test:webview-capabilities && npm run test:multi-window",
    "test:native-ui": "npm run test:menu-native && npm run test:tray-menu-native && npm run test:taskbar-native && npm run test:notification-native",
    "test:full": "npm test && npm run test:native && npm run test:native-ui && npm run test:rc",
    "test": "npm run test:runtime && npm run test:window-lifecycle && npm run test:exports && npm run test:types && npm run test:doctor && npm run test:fuzz && npm run test:limits && npm run test:install && npm run test:updater-failures && npm run test:example-tasks && npm run test:example-shapes && npm run test:napi && npm run test:error-logging && npm run test:ipc-security && npm run test:net && npm run test:updater && npm run test:plugins && npm run test:platform && npm run test:single-instance && npm run test:associations && npm run test:bundle && npm run test:menu && npm run test:taskbar && npm run test:window-colors && npm run test:notification && npm run test:bridge-embed && npm run test:package-inputs && npm run test:integrity && npm run test:cli",
    "security:repo": "node scripts/security-scan.js",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security:gate": "npm run security:repo && npm run security:audit && npm run build:security-analysis && npm run security:repo && npm run test:pe-hardening && npm run test:security-corpus && npm run test:fuzz && npm run test:limits && npm run test:updater-failures && npm run test:runtime && npm run test:error-logging && npm run test:ipc-security && npm run test:updater && npm run test:package-inputs && npm run test:integrity && npm run test:installer",
    "native:checksums": "node scripts/record-native-checksums.js",
    "generate:bridge": "node scripts/generate-bridge-header.js",
    "setup:webview2": "powershell -ExecutionPolicy Bypass -File scripts/setup-webview2.ps1",
    "debug": "npm run dev",
    "example:basic": "node examples/basic/app.js",
    "example:tasks": "node examples/tasks/app.js",
    "test:example-tasks": "node test/example-tasks.js",
    "example:digest": "node examples/digest/app.js",
    "example:focus": "node examples/focus/app.js",
    "test:example-shapes": "node test/example-shapes.js",
    "test:napi": "node test/napi-compatibility.js"
  },
  "gypfile": true,
  "dependencies": {
    "node-addon-api": "^8.6.0",
    "node-gyp": "^12.1.0"
  },
  "overrides": {
    "undici": "^6.28.0"
  },
  "engines": {
    "node": ">=20"
  },
  "nodeviewjs": {
    "name": "NodeViewDemo",
    "appId": "nodeviewjs-demo",
    "entry": "examples/basic/app.js",
    "metadata": {
      "companyName": "NodeViewJS",
      "fileDescription": "NodeViewJS Demo",
      "productName": "NodeViewJS Demo",
      "copyright": "Copyright (C) 2026 NodeViewJS contributors"
    }
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
